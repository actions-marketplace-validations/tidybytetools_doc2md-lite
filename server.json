{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.tidybytetools/doc2md-lite",
  "title": "doc2md-lite",
  "description": "Turn local text PDFs and HTML files into clean Markdown, tables kept. Runs on your computer.",
  "repository": {
    "url": "https://github.com/tidybytetools/doc2md-lite",
    "source": "github"
  },
  "websiteUrl": "https://tidybytetools.github.io/tools/doc2md/",
  "version": "1.2.2",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "doc2md-lite",
      "version": "1.2.2",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp",
          "description": "Starts the MCP server instead of the command-line tool."
        }
      ]
    }
  ]
}
